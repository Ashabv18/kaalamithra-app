# Normalize line endings so every clone (Windows, macOS, Linux, Vercel) gets
# byte-identical files. Without this, core.autocrlf=true rewrites text files to
# CRLF on Windows checkout, so a fresh clone serves slightly different bytes
# than the reference workspace (whitespace-only, but it breaks byte comparison).
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
